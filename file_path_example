#5. Build a File Path

example_file = "sample.txt"
file_path = os.path.join(current_directory, example_file)
print("\nExample Path:")
print(file_path)

#6. Check Whether a File Exists

if os.path.exists(file_path):
    print("File exists.")
else:
    print("File does not exist.")


# 7. Change Directories

# NOTE:
# Update this path to one that exists on your computer.

new_directory = r"P:\Courses\CIS 3680\Practice"

try:
    os.chdir(new_directory)
    print("\nDirectory successfully changed.")

    print("New Current Directory:")
    print(os.getcwd())
except FileNotFoundError:
    print("Directory was not found.")


#8. Search for All Text Files

print("\nText Files Found:")
for item in os.listdir():
    if item.endswith(".py"):
        print(item)


#9. Search an entire directory tree for files by extension

print("\nSearching for Python files...\n")

for folder_name, subfolders, filenames in os.walk(os.getcwd()):
    for filename in filenames:
        if filename.endswith(".py"):
            full_path = os.path.join(folder_name, filename)
            print(full_path)

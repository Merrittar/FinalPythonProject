""" File and Directory Management Example

This program demonstrates common file system operations:
1. Display the current working directory
2. List files and folders
3. Identify Python files
4. Change directories
5. Build file paths
6. Determine whether a path is a file or directory
7. Change directories
8. Search for files by extension
9. Search an entire directory tree for files by extension"""

import os

# 1. Display Current Directory

current_directory = os.getcwd()
print("Current Working Directory:")
print(current_directory)

#2. List Contents of Current Directory

print("\nContents of Current Directory:")
directory_contents = os.listdir(current_directory)
for item in directory_contents:
    print(item)


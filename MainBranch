#validate data for phone
def normalize_phone(phone):
    match = re.fullmatch(phone_reg, phone.strip())
    if not match:
        return None
    digits = re.sub(r"\D", "", phone)
    if len(digits) == 11 and digits.startswith("1"):
        digits = digits[1:]
    if len(digits) != 10:
        return None
    return f"({digits[:3]}) {digits[3:6]}-{digits[6:]}"


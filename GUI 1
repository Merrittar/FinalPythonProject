Tkinter_Template: #####



import tkinter as tk # Import the tkinter library and give it the shorter alias "tk"

# Create the main application window or "root" window. Every Tkinter application must have one root window, 
# which serves as the main container for all other widgets.
root = tk.Tk()    
# Set the title that appears in the window's title bar
root.title("Welcome")
                            #root.resizable(False, False)  # Prevent the user from resizing the window
    
# Create a Label widget (label constructor)
label = tk.Label(
    # Parent window where the label will be placed & indicates the label is a child of the root window
    root,  
    # Text displayed inside the label, which the user cannot edit
    text="Welcome to Foundations of Programming",
    font=("Arial", 14)
)
# Add the label to the window and place it on the screen
# pady=20 adds 20 pixels of vertical padding above and below the label
# The pack() method is a geometry manager that organizes widgets in blocks before placing them in the parent widget. 
# It automatically adjusts the size and position of the label based on its content and the available space in the window.

label.pack(pady=20)

# Start the GUI event loop
# This keeps the window open and waits for user actions such as a mouse click, keyboard input, window resizing, button press, etc.
# Without this line, the window would appear and then immediately close, as the program would finish executing.
root.mainloop()

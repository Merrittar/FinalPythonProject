Customer_Lookup: #####



import tkinter as tk

def search_customer():
    customer_id = entry.get()

    result_label.config(
        text=f"Searching for Customer ID {customer_id}"
    )

root = tk.Tk()
root.title("Customer Lookup")

tk.Label(
    root,
    text="Customer ID:"
).pack()

entry = tk.Entry(root)
entry.pack()

search_button = tk.Button(
    root,
    text="Search",
    command=search_customer
)

search_button.pack(pady=10)

result_label = tk.Label(root, text="")
result_label.pack()

root.mainloop()




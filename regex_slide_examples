pattern = r"(abc)" #matches the exact sequence "abc" and captures it as a group
text = "abcABC123deFabc"
match = re.findall(pattern, text)
print(match)

pattern = r"(?:abc)" #matches the exact sequence "abc" but does not capture it as a group
text = "abcABC123deFabc"
match = re.findall(pattern, text)
print(match)

pattern =r"(?P<name>abc)" #matches the exact sequence "abc" and captures it as a group named "name"
text = "abcABC123deFabc"
match = re.search(pattern, text)
print(match.group("name"))

pattern = r"(abc)\1" #matches the exact sequence "abc" followed by the same sequence again (i.e., "abcabc")
text = "abcabcABC123abc"
match = re.search(pattern, text)
print(match.group(0))

pattern = r"^[a-zA-Z0-9.%+-]+@[a-zA-Z0-9.-]+\.[a-zA-Z]{2,}$" #matches a valid email address
text = "sharpers@appstate.edu"
match = re.search(pattern, text)
if match:
    print("Valid email address:", text)
else:
    print("Invalid email address", text)

